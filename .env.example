# Copy this file to .env and fill in real values.
# .env is gitignored; this template is not, so never put real secrets here.

# Environment under test, no trailing slash.
TSR_BASE_URL=https://admin.dev.turnkeysr.ai

# Test account. Must be a Yopmail address: the suite reads its OTP from that
TSR_EMAIL=your.name@yopmail.com
TSR_PASSWORD=your-password

# Display name the dashboard greets this account with ("Welcome, <name>!").
TSR_USER_NAME=Your Name

# Where the OTP is read from. Its own origin, so it cannot use TSR_BASE_URL.
YOPMAIL_URL=https://yopmail.com/en/
